# =============================================================================
# Bureau of Indian Standards (BIS) Agentic RAG Assistant - Environment Config
# =============================================================================
# Copy this file to .env and fill in your credentials.

# --- LLM API Providers (At least one required) ---
GOOGLE_API_KEY="your-google-gemini-api-key"
MISTRAL_API_KEY="your-mistral-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key-optional"

# --- Model & Embedding Configuration ---
# Options: gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.6-flash, mistral-large-latest
BIS_LLM_MODEL="gemini-3.5-flash"
LLM_MODEL="gemini-3.5-flash"
BIS_LLM_TEMPERATURE="0.2"

# Embedding Options: MistralAIEmbeddings, Google, fastembed (local ONNX - $0.00 cost), Ollama
BIS_EMBEDDING_PROVIDER="MistralAIEmbeddings"
EMBEDDING_PROVIDER="MistralAIEmbeddings"
BIS_EMBEDDING_MODEL="mistral-embed-2312"

# Ollama Local Settings (if using local Ollama)
OLLAMA_BASE_URL="http://localhost:11434"

# --- Vector Database & Storage ---
# Options: pgvector (Supabase PostgreSQL) or chroma (Local ChromaDB)
BIS_VECTOR_STORE_TYPE="pgvector"
BIS_CHROMA_PATH="data/chroma_db"
BIS_CACHE_PATH="data/cache.json"
BIS_CACHE_ENABLED="true"

# --- Supabase PostgreSQL Connection (For PGVector & User Auth) ---
DATABASE_URL="postgresql+asyncpg://postgres:password@db.supabase.co:6543/postgres"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-key"

# --- Google OAuth Client ID (Optional for Frontend Google Sign-In) ---
GOOGLE_CLIENT_ID="your-google-oauth-client-id"

# --- Retrieval Tuning ---
BIS_RETRIEVER_K="3"
BIS_RERANK_TOP_N="2"
BIS_HISTORY_WINDOW="3"
BIS_MAX_STORED_HISTORY="5"
BIS_LOG_LEVEL="INFO"

# --- Server Deployment ---
PORT="8000"
HOST="0.0.0.0"
WORKERS="1"
